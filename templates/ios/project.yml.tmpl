name: __PROJECT_NAME__
options:
  bundleIdPrefix: com.example
  deploymentTarget:
    iOS: "17.0"
  xcodeVersion: "16.0"
  generateEmptyDirectories: true

settings:
  base:
    SWIFT_VERSION: "6.0"
    MARKETING_VERSION: "1.0.0"
    CURRENT_PROJECT_VERSION: 1

targets:
  __PROJECT_NAME__:
    type: application
    platform: iOS
    sources:
      - Sources
    resources:
      - Resources
    settings:
      base:
        INFOPLIST_FILE: Resources/Info.plist
        PRODUCT_BUNDLE_IDENTIFIER: com.example.__PROJECT_NAME__
        ASSETCATALOG_COMPILER_APPICON_NAME: AppIcon

  __PROJECT_NAME__Tests:
    type: bundle.unit-test
    platform: iOS
    sources:
      - Tests
    dependencies:
      - target: __PROJECT_NAME__
    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: com.example.__PROJECT_NAME__Tests
